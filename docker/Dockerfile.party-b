FROM golang:1.25-alpine AS builder

RUN apk add --no-cache git

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /party-b ./cmd/party-b

FROM alpine:3.21
RUN apk add --no-cache ca-certificates
COPY --from=builder /party-b /usr/local/bin/party-b

EXPOSE 9000
ENTRYPOINT ["party-b"]
CMD ["-config", "/etc/crypto-claw/config.json", "-passphrase", ""]
